# Veritabanı (Railway PostgreSQL bağlantı bilgisi buraya)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Sunucu
PORT=3000

# NOT: NetGSM bilgileri artık global .env değil, her berberin kendi hesabında
# (mobil uygulama > SMS Ayarları ekranından) saklanıyor. Buraya bir şey eklemene gerek yok.

# Varsayılan aylık SMS kotası
DEFAULT_SMS_QUOTA=500
